# Public port: serves the UI and /api/auth/* — this is the one nginx routes to
PORT=3000

# Internal-only port: serves GET /pubkey only.
# In docker-compose, do NOT publish this port to the host.
# Other services reach it as http://auth-service:4000/pubkey over app-net.
INTERNAL_PORT=4000

# MongoDB connection (auth-db, on its own isolated network)
MONGO_URI=mongodb://authuser:changeme@auth-db:27017/authdb?authSource=admin

# Identifies which signing key this instance uses (matches JWT "kid")
AUTH_KEY_ID=auth-key-2026-09
TOKEN_ISSUER=ctf-auth-service

# Access token: short-lived JWT (jose duration string, e.g. 15m, 1h)
ACCESS_TOKEN_TTL=15m
# Refresh token: long-lived opaque token, rotated on every use
REFRESH_TOKEN_TTL_DAYS=7

# Where the RSA keypair lives on disk (mounted as a volume, never baked into the image)
PRIVATE_KEY_PATH=./keys/private.pem
PUBLIC_KEY_PATH=./keys/public.pem
